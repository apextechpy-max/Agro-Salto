# Configuración de Base de Datos (Supabase)
# Usa la 'Transaction connection string' de Supabase (puerto 6543 o 5432 con pooling)
DATABASE_URL=postgres://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Auth / Client (Opcional si usas el cliente JS para Storage o Auth)
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=your-anon-key

# JWT Secret para Auth
JWT_SECRET=tu_secreto_super_seguro_aqui

# Puerto Local
PORT=3001
NODE_ENV=development
